NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Configure at least one hosted AI provider for public use.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Server-only. Required for in-app account deletion. Never use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay recurring billing. Keep every value server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# Optional local development provider.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
